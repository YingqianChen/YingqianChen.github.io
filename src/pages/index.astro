---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects', ({ data }) => !data.draft);
const projects = all
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<Base>
  <section class="mx-auto w-full max-w-prose px-6 pt-24 pb-12">
    <h1 class="text-4xl font-semibold tracking-tight">Yingqian Chen</h1>
    <p class="mt-4 text-lg text-ink-muted dark:text-ink-muted-dark">
      A portfolio of work in machine learning, deep learning, LLM applications, and data visualization.
    </p>

    <div class="mt-10">
      <p class="font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        What I work with
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-sm border border-rule p-5 transition-colors hover:border-accent dark:border-rule-dark dark:hover:border-accent-dark">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 bg-accent dark:bg-accent-dark"></span>
            <p class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Data visualization</p>
          </div>
          <p class="mt-3 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">Tableau · R · SVG · Matplotlib</p>
        </div>
        <div class="rounded-sm border border-rule p-5 transition-colors hover:border-accent dark:border-rule-dark dark:hover:border-accent-dark">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 bg-accent dark:bg-accent-dark"></span>
            <p class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Machine learning</p>
          </div>
          <p class="mt-3 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">scikit-learn · SHAP · NumPy · pandas</p>
        </div>
        <div class="rounded-sm border border-rule p-5 transition-colors hover:border-accent dark:border-rule-dark dark:hover:border-accent-dark">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 bg-accent dark:bg-accent-dark"></span>
            <p class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Deep learning</p>
          </div>
          <p class="mt-3 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">PyTorch · BiLSTM · RNN</p>
        </div>
        <div class="rounded-sm border border-rule p-5 transition-colors hover:border-accent dark:border-rule-dark dark:hover:border-accent-dark">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 bg-accent dark:bg-accent-dark"></span>
            <p class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">LLM & agents</p>
          </div>
          <p class="mt-3 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">LangGraph · RAG · tool-use agents · PaddleOCR · BM25 · Groq</p>
        </div>
        <div class="rounded-sm border border-rule p-5 transition-colors hover:border-accent dark:border-rule-dark dark:hover:border-accent-dark">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 bg-accent dark:bg-accent-dark"></span>
            <p class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Web & backend</p>
          </div>
          <p class="mt-3 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">FastAPI · Next.js · PostgreSQL</p>
        </div>
        <div class="rounded-sm border border-rule p-5 transition-colors hover:border-accent dark:border-rule-dark dark:hover:border-accent-dark">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 bg-accent dark:bg-accent-dark"></span>
            <p class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Languages</p>
          </div>
          <p class="mt-3 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">Python · R · SQL · Java</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-prose px-6 pb-24">
    <div class="mb-6 flex items-baseline justify-between border-b border-rule dark:border-rule-dark pb-3">
      <h2 class="font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        Recent projects
      </h2>
      {projects.length > 0 && (
        <a href="/projects/" class="no-underline hover:underline font-mono text-meta uppercase">
          all &rarr;
        </a>
      )}
    </div>

    {projects.length === 0 ? (
      <p class="py-12 text-center font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        No posts yet &mdash; run <code>/new-post</code> to draft the first one.
      </p>
    ) : (
      projects.map((entry) => <ProjectCard entry={entry} />)
    )}
  </section>
</Base>
