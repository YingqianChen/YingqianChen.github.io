---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects', ({ data }) => !data.draft);
const projects = all
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<Base>
  <section class="mx-auto w-full max-w-prose px-6 pt-24 pb-12">
    <h1 class="text-4xl font-semibold tracking-tight">Yingqian Chen</h1>
    <p class="mt-4 text-lg text-ink-muted dark:text-ink-muted-dark">
      Building with data, models, and a bit of design.
    </p>

    <div class="mt-10">
      <p class="font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        What I work with
      </p>

      <div class="mt-4 border-t border-rule dark:border-rule-dark">
        <div class="border-b border-rule py-4 dark:border-rule-dark">
          <div class="flex items-baseline gap-x-4">
            <span class="w-5 shrink-0 font-mono text-meta text-accent dark:text-accent-dark">01</span>
            <span class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Data visualization</span>
          </div>
          <p class="mt-1.5 pl-9 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">Tableau · R · SVG · Matplotlib</p>
        </div>
        <div class="border-b border-rule py-4 dark:border-rule-dark">
          <div class="flex items-baseline gap-x-4">
            <span class="w-5 shrink-0 font-mono text-meta text-accent dark:text-accent-dark">02</span>
            <span class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Machine learning</span>
          </div>
          <p class="mt-1.5 pl-9 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">scikit-learn · SHAP · NumPy · pandas</p>
        </div>
        <div class="border-b border-rule py-4 dark:border-rule-dark">
          <div class="flex items-baseline gap-x-4">
            <span class="w-5 shrink-0 font-mono text-meta text-accent dark:text-accent-dark">03</span>
            <span class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Deep learning</span>
          </div>
          <p class="mt-1.5 pl-9 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">PyTorch · BiLSTM · RNN</p>
        </div>
        <div class="border-b border-rule py-4 dark:border-rule-dark">
          <div class="flex items-baseline gap-x-4">
            <span class="w-5 shrink-0 font-mono text-meta text-accent dark:text-accent-dark">04</span>
            <span class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">LLM & agents</span>
          </div>
          <p class="mt-1.5 pl-9 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">LangGraph · RAG · tool-use agents · PaddleOCR · BM25 · Groq</p>
        </div>
        <div class="border-b border-rule py-4 dark:border-rule-dark">
          <div class="flex items-baseline gap-x-4">
            <span class="w-5 shrink-0 font-mono text-meta text-accent dark:text-accent-dark">05</span>
            <span class="font-mono text-meta uppercase tracking-wide text-ink dark:text-ink-dark">Web & backend</span>
          </div>
          <p class="mt-1.5 pl-9 font-mono text-sm leading-relaxed text-ink-muted dark:text-ink-muted-dark">FastAPI · Next.js · PostgreSQL</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-prose px-6 pb-24">
    <div class="mb-6 flex items-baseline justify-between border-b border-rule dark:border-rule-dark pb-3">
      <h2 class="font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        Recent projects
      </h2>
      {projects.length > 0 && (
        <a href="/projects/" class="no-underline hover:underline font-mono text-meta uppercase">
          all &rarr;
        </a>
      )}
    </div>

    {projects.length === 0 ? (
      <p class="py-12 text-center font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        No posts yet &mdash; run <code>/new-post</code> to draft the first one.
      </p>
    ) : (
      projects.map((entry) => <ProjectCard entry={entry} />)
    )}
  </section>
</Base>
