---
import Base from './Base.astro';
import TechTag from '../components/TechTag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { data } = entry;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
});

const statusLabel: Record<typeof data.status, string> = {
  shipped: 'shipped',
  'in-progress': 'in progress',
  archived: 'archived',
};
---

<Base title={data.title} description={data.summary} ogImage={data.cover}>
  <article class="mx-auto w-full max-w-prose px-6 pt-16 pb-8">
    <header class="mb-10">
      <p class="mb-2 font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
        {dateFmt.format(data.date)} &middot; {statusLabel[data.status]}
      </p>
      <h1 class="text-3xl font-semibold tracking-tight">{data.title}</h1>
      <p class="mt-3 text-lg text-ink-muted dark:text-ink-muted-dark">{data.summary}</p>

      {data.tech.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1">
          {data.tech.map((t) => <TechTag label={t} />)}
        </div>
      )}

      {(data.repo || data.demo) && (
        <div class="mt-5 flex gap-5 font-mono text-meta uppercase">
          {data.repo && <a href={data.repo} class="no-underline hover:underline">repo &rarr;</a>}
          {data.demo && <a href={data.demo} class="no-underline hover:underline">demo &rarr;</a>}
        </div>
      )}
    </header>

    <hr class="mb-10" />

    <div class="prose-body">
      <slot />
    </div>
  </article>
</Base>
