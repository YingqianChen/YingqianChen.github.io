---
import TechTag from './TechTag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { data, slug } = entry;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="group py-8 border-b border-rule dark:border-rule-dark last:border-0">
  <a href={`/projects/${slug}/`} class="no-underline block">
    <h2 class="text-xl font-semibold tracking-tight group-hover:underline decoration-accent">
      {data.title}
    </h2>

    {data.tech.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
        {data.tech.map((t) => <TechTag label={t} />)}
      </div>
    )}

    <p class="mt-3 text-ink-muted dark:text-ink-muted-dark">{data.summary}</p>

    <p class="mt-3 font-mono text-meta uppercase text-ink-muted dark:text-ink-muted-dark">
      {dateFmt.format(data.date)} &middot; read &rarr;
    </p>
  </a>
</article>
